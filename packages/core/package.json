{
  "name": "@stamprally/core",
  "version": "0.11.0",
  "description": "A dependency-free stamp rally domain engine and storage-agnostic client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitta-a/stamprally-core-app.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nitta-a/stamprally-core-app/issues"
  },
  "homepage": "https://github.com/nitta-a/stamprally-core-app#readme",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
