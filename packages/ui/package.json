{
  "name": "@stamprally/ui",
  "version": "0.22.0",
  "description": "Accessible participant UI components for stamp rallies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/stamprally-core-app.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/nitta-a/stamprally-core-app/issues"
  },
  "homepage": "https://github.com/nitta-a/stamprally-core-app#readme",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-package-css.mjs packages/ui && node ../../scripts/ensure-client-directive.mjs .",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stamprally/core": "workspace:*",
    "@stamprally/react": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
