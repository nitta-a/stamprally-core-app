{
  "name": "@stamprally/react",
  "version": "0.17.0",
  "description": "React hooks for @stamprally/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitta-a/stamprally-core-app.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/nitta-a/stamprally-core-app/issues"
  },
  "homepage": "https://github.com/nitta-a/stamprally-core-app#readme",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/ensure-client-directive.mjs .",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stamprally/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
